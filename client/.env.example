# Public API base (no trailing slash). Example for production:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Frontend-only demo chat. This key is visible in the browser; use a server proxy for production.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash
